# Copy to deploy/.env, chmod 600. Never commit deploy/.env.

# Bearer keys as `label=key` pairs, one per client. openssl rand -hex 32
TAGGING_MS_API_KEYS=client-a=<hex>,client-b=<hex>

TAGGING_MS_ACOUSTID_API_KEY=<...>
TAGGING_MS_USER_AGENT=tagging-ms/0.2 ( https://github.com/j-milkovits/music_tagging_ms )

# Local mirror.
TAGGING_MS_MB_BASE_URL=http://musicbrainz:5000/ws/2
TAGGING_MS_MB_RATE_LIMIT_MS=0
TAGGING_MS_MB_CONCURRENCY=8
