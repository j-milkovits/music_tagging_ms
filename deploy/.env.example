# Copy to deploy/.env, chmod 600. Never commit deploy/.env.

# Per-client bearer keys, `label=key` pairs. Generate each with: openssl rand -hex 32
TAGGING_MS_API_KEYS=jonas-laptop=<hex>,papa-desktop=<hex>,frontend=<hex>
TAGGING_MS_ACOUSTID_API_KEY=<...>
TAGGING_MS_USER_AGENT=tagging-ms/0.2 ( https://github.com/j-milkovits/tagging_ms )

# Local mirror (musicbrainz-docker on the same host).
TAGGING_MS_MB_BASE_URL=http://musicbrainz:5000/ws/2
TAGGING_MS_MB_RATE_LIMIT_MS=0
TAGGING_MS_MB_CONCURRENCY=8

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> mbmirror).
TUNNEL_TOKEN=<...>
