TAGGING_MS_HOST=0.0.0.0
TAGGING_MS_PORT=8000
TAGGING_MS_API_KEY=change-me
TAGGING_MS_ACOUSTID_API_KEY=<...>
TAGGING_MS_USER_AGENT=tagging-ms/0.2 ( https://github.com/j-milkovits/tagging_ms )

# MusicBrainz upstream. Defaults are the public API and its limits (1 req/s, sequential).
# For a local mirror set all three; the service refuses to start if the URL is still
# musicbrainz.org while the limits are below the public ones.
TAGGING_MS_MB_BASE_URL=https://musicbrainz.org/ws/2
TAGGING_MS_MB_RATE_LIMIT_MS=1000
TAGGING_MS_MB_CONCURRENCY=1
# Mirror values:
# TAGGING_MS_MB_BASE_URL=http://musicbrainz:5000/ws/2
# TAGGING_MS_MB_RATE_LIMIT_MS=0
# TAGGING_MS_MB_CONCURRENCY=8
